{
  "name": "sql-practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sparta Global SQL practice lab: a learning path and query quizzes that run SQL in the browser.",
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "node scripts/check.mjs && node scripts/build.mjs",
    "dev": "node --watch-path=./src --watch-path=./data scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "report": "node scripts/report.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "sql.js": "1.12.0",
    "three": "^0.149.0"
  },
  "engines": {
    "node": ">=20"
  }
}
